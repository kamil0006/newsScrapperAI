// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Article {
  id            String    @id @default(cuid())

  // source
  sourceType    String // "hackernews" | "rss"
  sourceName    String // e.g. "Hacker News", "r/technology", "The Verge"
  externalId    String? // id of the post at the source, for deduplication
  url           String    @unique
  title         String
  content       String? // excerpt/text used for classification
  score         Int? // points/upvotes from the source
  commentsCount Int?
  publishedAt   DateTime?
  fetchedAt     DateTime  @default(now())

  // AI classification
  category      String? // "AI" | "Gaming" | "Tech" | "Inne"
  priority      Int? // 1 (skip) - 5 (must read)
  worthReading  Boolean?
  summary       String?
  classifiedAt  DateTime?

  // deduplication of the same story across different sources
  duplicateOfId String?
  duplicateOf   Article?  @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates    Article[] @relation("Duplicates")

  // number of independent sources that covered the same story (only set on
  // the canonical article — duplicates pointing to it always stay at 1)
  consensusSources Int @default(1)

  // content reliability — only computed once we have the full article text
  // (deep classification), otherwise stays null, since a title alone isn't
  // enough to judge whether something is fluff
  qualityLabel String? // "rzetelny" | "przeciętny" | "lanie_wody"
  qualityNote  String? // one-sentence justification for the rating

  // topic thread — groups successive updates to the same unfolding story
  // over time (related, but NOT identical like a duplicate).
  // The value is the id of the article that started the thread; that
  // article carries its own id here once the thread exists.
  threadId String?

  // hard content filters — applied everywhere, not just the main view
  sponsored Boolean @default(false) // ad/affiliate/promo, detected via keywords OR by AI
  language  String? // "pl" | "en" | "other" — null until classified

  articleStates ArticleState[]

  @@index([sourceType])
  @@index([category])
  @@index([priority])
  @@index([publishedAt])
  @@index([duplicateOfId])
  @@index([threadId])
  @@index([sponsored])
  @@index([language])
}

// a registered account — email+password auth, no email verification yet
// (needs a purchased domain + Resend, which comes later)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // comma-separated Category values this user doesn't want to see —
  // everyone starts seeing everything, hiding is opt-out per account
  hiddenCategories String @default("")

  articleStates ArticleState[]
  visitState    VisitState?
}

// per-user reading state for an article — read/saved/dismissed used to live
// directly on Article, but once there's more than one account those flags
// must be personal, not shared across everyone using the app
model ArticleState {
  id          String    @id @default(cuid())
  userId      String
  articleId   String
  read        Boolean   @default(false)
  readAt      DateTime?
  saved       Boolean   @default(false)
  dismissed   Boolean   @default(false)
  dismissedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([dismissed])
}

// daily AI-written paragraph synthesizing the last 24h of news, generated
// on every scrape run and overwritten for the current date
model DailyBrief {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  content   String
  createdAt DateTime @default(now())
}

// when a user last actually visited the homepage — used for "catch-up"
// mode after a longer absence, one row per account
model VisitState {
  id            String   @id @default(cuid())
  userId        String   @unique
  lastVisitedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
