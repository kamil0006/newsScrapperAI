# Skopiuj do .env i uzupełnij prawdziwymi wartościami — ten plik jest
# bezpieczny do commitowania, bo nie zawiera żadnych sekretów.

DATABASE_URL="file:./prisma/dev.db"

# Klucz do klasyfikacji/oceny newsów (OpenAI)
OPENAI_API_KEY=""

# Opcjonalnie: model inny niż domyślny gpt-4o-mini
# OPENAI_MODEL="gpt-4o-mini"

# Klucz do podpisywania sesji logowania — wygeneruj przez: openssl rand -base64 32
SESSION_SECRET=""
