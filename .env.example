# Copy to .env and fill in real values — this file is safe to commit
# because it contains no secrets.

DATABASE_URL="file:./prisma/dev.db"

# Key for classifying/scoring news (OpenAI)
OPENAI_API_KEY=""

# Optional: use a model other than the default gpt-4o-mini
# OPENAI_MODEL="gpt-4o-mini"

# Key for signing login sessions — generate with: openssl rand -base64 32
SESSION_SECRET=""
